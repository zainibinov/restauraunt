  "components": {
    "schemas": {
      "BookingResponse": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "tableId": {
            "type": "string",
            "format": "uuid"
          },
          "startTime": {
            "type": "string",
            "format": "date-time"
          },
          "endTime": {
            "type": "string",
            "format": "date-time"
          },
          "guestsCount": {
            "type": "integer",
            "format": "int32"
          },
          "status": {
            "type": "string",
            "nullable": true
          },
          "creationDate": {
            "type": "string",
            "format": "date-time"
          },
          "confirmationCode": {
            "type": "string",
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "CreateBookingRequest": {
        "required": [
          "idempotencyKey",
          "startTime",
          "tableId"
        ],
        "type": "object",
        "properties": {
          "tableId": {
            "type": "string",
            "format": "uuid"
          },
          "startTime": {
            "type": "string",
            "format": "date-time"
          },
          "guestsCount": {
            "maximum": 100,
            "minimum": 1,
            "type": "integer",
            "format": "int32"
          },
          "guestName": {
            "maxLength": 100,
            "type": "string",
            "nullable": true
          },
          "guestPhone": {
            "maxLength": 20,
            "type": "string",
            "nullable": true
          },
          "guestEmail": {
            "maxLength": 256,
            "type": "string",
            "format": "email",
            "nullable": true
          },
          "idempotencyKey": {
            "maxLength": 100,
            "minLength": 1,
            "type": "string"
          }
        },
        "additionalProperties": false
      },
      "UpdateBookingRequest": {
        "required": [
          "startTime",
          "tableId"
        ],
        "type": "object",
        "properties": {
          "tableId": {
            "type": "string",
            "format": "uuid"
          },
          "startTime": {
            "type": "string",
            "format": "date-time"
          },
          "guestsCount": {
            "maximum": 100,
            "minimum": 1,
            "type": "integer",
            "format": "int32"
          }
        },
        "additionalProperties": false
      }
    },
    "securitySchemes": {
      "Bearer": {
        "type": "http",
        "description": "Paste the accessToken from AuthService (without the word Bearer)",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    }
