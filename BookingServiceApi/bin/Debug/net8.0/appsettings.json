{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "BookingDb": "Server=localhost;Port=3306;Database=bookingdb;User=root;Password=root"
  },
  "Jwt": {
    "Issuer": "AuthService",
    "Audience": "RestaurantBooking",
    "Key": "change-me-to-a-long-random-string-of-at-least-32-characters"
  },
  "Booking": {
    "PendingTimeoutMinutes": 30,
    "ReminderHoursBefore": 2
  },
  "Services": {
    "UseFakeClients": false
  },
  "Grpc": {
    "AuthUrl": "http://localhost:5011",
    "AvailabilityUrl": "http://localhost:5012"
  },
  "Redis": {
    "ConnectionString": "localhost:6379"

  },
  "RabbitMq": {
    "Host": "localhost",
    "Port": 5672,
    "User": "guest",
    "Password": "guest",
    "Exchange": "restaurant.events"
  }
}